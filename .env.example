# Application environment: development | production
APP_ENV=development
SECRET_KEY=generate-a-long-random-secret-key

# Supabase / PostgreSQL (preferred on `supabase` branch)
# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Optional: individual Postgres settings (if DATABASE_URL is not set)
# DB_HOST=db.[project-ref].supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-supabase-db-password
# DB_NAME=postgres
# DB_SSL=true

# Local MySQL (used by copy_local_to_supabase.py source only)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=listmap
DB_SSL=false

# Flask Server configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Authentication
AUTH_ENABLED=True
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-admin-password
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=change-user-password

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=120 per minute

# Session lifetime (minutes of inactivity before re-login)
SESSION_LIFETIME_MINUTES=30
