# Application environment: development | production
APP_ENV=development
SECRET_KEY=generate-a-long-random-secret-key

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=listmap

# Flask Server configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Authentication
AUTH_ENABLED=True
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-admin-password
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=change-user-password

# Legacy aliases (still supported)
# AUTH_VIEWER_USERNAME=user
# AUTH_VIEWER_PASSWORD=change-user-password

# Legacy fallback (used if AUTH_ADMIN_* not set)
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-this-password

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=120 per minute

# Session lifetime (minutes of inactivity before re-login)
SESSION_LIFETIME_MINUTES=30
